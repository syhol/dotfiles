#!/usr/bin/env bash
#MISE description="Install editor/CLI plugins and shell completions"
#
# Runs at the end of `mise bootstrap` (step 8), with tools on PATH. Covers
# everything the declarative sections can't: helm/gh plugins, yazi packages,
# bat cache, shell plugins. Homebrew formulae, casks AND VS Code extensions are
# declarative now, in [bootstrap.packages].
set -e

# Homebrew backs [bootstrap.packages]; install it if missing (a fresh machine
# that ran `mise bootstrap` will already have it from step 1).
if ! command -v brew >/dev/null 2>&1; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$(/opt/homebrew/bin/brew shellenv)"

helm plugin install https://github.com/databus23/helm-diff || true
helm plugin update diff || true
gh extension install dlvhdr/gh-dash || true
gh extension upgrade --all || true
ya pkg install || true
nvim --headless "+Lazy! restore" +qa || true # install nvim plugins at locked versions
bat cache --build
~/.config/bash/plugins.bash sync
~/.config/fish/plugins.fish sync
~/.config/zsh/plugins.zsh sync
touch ~/.config/shell/secrets.sh
